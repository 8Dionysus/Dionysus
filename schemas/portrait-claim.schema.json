{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8dionysus.github.io/Dionysus/schemas/portrait-claim.schema.json",
  "title": "Dionysus portrait claim",
  "description": "One scoped, evidence-grounded and reviewable interpretation. A claim is not an authoritative identity fact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "subject_local_id",
    "statement",
    "status",
    "basis",
    "scope",
    "confidence",
    "evidence_refs",
    "counterevidence_refs",
    "alternatives",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_local_id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "contested",
        "retired"
      ]
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "self-stated",
          "described-episode",
          "interviewer-inference",
          "external-witness"
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contexts",
        "time_horizon",
        "limits"
      ],
      "properties": {
        "contexts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "time_horizon": {
          "type": "string",
          "enum": [
            "event",
            "current",
            "recurring",
            "longitudinal",
            "unknown"
          ]
        },
        "limits": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Calibration of the claim under its stated scope, not confidence in the person."
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "relation"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "supports",
              "qualifies"
            ]
          }
        }
      }
    },
    "counterevidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "relation"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "const": "challenges"
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reviewed_at",
        "review_note"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unreviewed",
            "accepted",
            "edited",
            "contested",
            "rejected",
            "retired"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "review_note": {
          "type": "string"
        }
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
